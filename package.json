{
  "name": "sync-with-rclone",
  "type": "module",
  "version": "1.0.4",
  "description": "Project-folder sync tool with rclone, diff review, and selective apply.",
  "author": "",
  "license": "ISC",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "main": "src/electron/main/index.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "dev:desktop": "node build/dev-electron.js",
    "verify:win-assets": "node build/verify-win-assets.js",
    "predist:win": "npm run verify:win-assets",
    "prepack:win": "npm run verify:win-assets",
    "dist:win": "electron-builder --win nsis --x64",
    "pack:win": "electron-builder --win dir --x64",
    "start": "node src/cli/index.js",
    "desktop": "electron .",
    "test": "node --test"
  },
  "build": {
    "appId": "com.xiaobo.sync-with-rclone",
    "productName": "sync-with-rclone",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/binaries",
        "to": "binaries"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "build/windows-installer.ps1",
        "to": "scripts/windows-installer.ps1"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "sync-with-rclone"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "runAfterFinish": false
    }
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.1.0",
    "vite": "^7.1.7"
  }
}
