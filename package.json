{
  "name": "sync-with-rclone",
  "type": "module",
  "version": "1.0.4",
  "description": "Project-folder sync tool with rclone, diff review, and selective apply.",
  "author": "",
  "license": "ISC",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "main": "src/electron/main/index.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "dev": "node scripts/dev/dev-electron.js",
    "dev:session": "node scripts/dev/dev-electron.js --session",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "dev:desktop": "node scripts/dev/dev-electron.js --session",
    "build:icons": "node scripts/build/generate-icons.js",
    "verify:assets": "node scripts/build/verify-assets.js",
    "verify:build": "node scripts/build/verify-build.js",
    "predist:win": "npm run verify:assets -- win && npm run build:renderer && npm run verify:build",
    "prepack:win": "npm run verify:assets -- win && npm run build:renderer && npm run verify:build",
    "predist:mac": "npm run verify:assets -- mac && npm run build:renderer",
    "prepack:mac": "npm run verify:assets -- mac && npm run build:renderer",
    "dist:win": "electron-builder --win nsis --x64",
    "pack:win": "electron-builder --win dir --x64",
    "dist:mac": "node scripts/build/build-mac.js dmg,zip arm64",
    "dist:mac:x64": "node scripts/build/build-mac.js dmg,zip x64",
    "pack:mac": "node scripts/build/build-mac.js dir arm64",
    "pack:mac:x64": "node scripts/build/build-mac.js dir x64",
    "dist:pkg": "node scripts/build/build-mac.js pkg arm64",
    "dist:pkg:x64": "node scripts/build/build-mac.js pkg x64",
    "pack:pkg": "node scripts/build/build-mac.js pkg arm64",
    "pack:pkg:x64": "node scripts/build/build-mac.js pkg x64",
    "start:cli": "node src/cli/index.js",
    "start:desktop": "electron .",
    "test": "node --test"
  },
  "build": {
    "appId": "com.xiaobo.sync-with-rclone",
    "productName": "sync-with-rclone",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates"
      },
      {
        "from": "scripts/install/macos-menu.sh",
        "to": "scripts/macos-menu.sh"
      },
      {
        "from": "scripts/install/windows-installer.ps1",
        "to": "scripts/windows-installer.ps1"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "scripts/install/icon.png"
    },
    "dmg": {
      "icon": "scripts/install/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "sync-with-rclone",
      "icon": "scripts/install/icon.ico",
      "extraResources": [
        {
          "from": "resources/binaries",
          "to": "binaries",
          "filter": [
            "rclone-windows-amd64.exe"
          ]
        }
      ]
    },
    "pkg": {
      "scripts": "scripts/install/pkg-scripts",
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "isRelocatable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "include": "scripts/install/installer.nsh",
      "runAfterFinish": false
    }
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.1.0",
    "tailwindcss": "^4.2.2",
    "vite": "^7.1.7"
  }
}
