const fs = require('node:fs')
const path = require('node:path')
const process = require('node:process')

const { app, protocol, BrowserWindow, ipcMain, Menu } = require('electron')

const execDirPath = (app.isPackaged && process.env.PORTABLE_EXECUTABLE_DIR) ? process.env.PORTABLE_EXECUTABLE_DIR : process.cwd()
console.log('execDirPath:', execDirPath)
/**
 * 判断是否开发模式
 */
function resolveIsDev() {
  // 读取命令行参数
  const arg = process.argv.find(arg => arg.startsWith('--dev'))
  if (arg) {
    return true
  }

  // 1️⃣ 外置 settings.json
  try {
    const configPath = path.join(execDirPath, 'settings.json')

    if (fs.existsSync(configPath)) {
      const cfg = JSON.parse(fs.readFileSync(configPath, 'utf-8'))
      if (typeof cfg.dev === 'boolean') {
        return cfg.dev
      }
    }
  }
  catch {}

  // 2️⃣ npm run dev 时的环境变量
  if (process.env.ELECTRON_MODE === 'dev') {
    return true
  }

  // 3️⃣ fallback：未打包 = dev
  return !app.isPackaged
}
const isDev = resolveIsDev()
console.log('[Electron] isDev =', isDev)

/**
 * 创建窗口
 */
let win
function createWindow() {
  win = new BrowserWindow({
    width: 1920,
    height: 1080,
    fullscreen: !isDev, // 启动即全屏
    frame: true,
    icon: path.join(__dirname, '/yuhuashuwu.ico'),
    autoHideMenuBar: false,
    webPreferences: {
      preload: path.join(__dirname, '/preload.js'),
    },
  })

  // 加载url
  const loadURL = isDev
    ? 'http://localhost:3000'
    : 'https://chat.yuhuashuwu.cn'
  win.loadURL(loadURL)

  // 麦克风权限自动放行
  win.webContents.session.setPermissionRequestHandler(
    (wc, permission, callback) => {
      if (permission === 'media')
        callback(true)
      else callback(false)
    },
  )
}

/**
 * 加载字体文件
 */
function registerFontAssets() {
  protocol.registerFileProtocol('app-font', (request, callback) => {
    const fileName = request.url.replace('app-font://', '')
    const filePath = app.isPackaged ? path.join(process.resourcesPath, 'fonts', fileName) : path.join(__dirname, '..', 'public', 'fonts', fileName)

    console.log('filePath:', filePath)
    callback({ path: filePath })
  })
}

/**
 * 设置开机启动
 */
let autoLaunchEnabled = false
function initAutoLaunchState() {
  if (!app.isPackaged)
    return

  const settings = app.getLoginItemSettings()
  autoLaunchEnabled = settings.openAtLogin && settings.path === path.join(execDirPath, path.basename(process.execPath))
}

function setAutoLaunch(enabled) {
  if (!app.isPackaged)
    return // 只在打包后生效

  autoLaunchEnabled = enabled

  app.setLoginItemSettings({
    openAtLogin: enabled,
    path: path.join(execDirPath, path.basename(process.execPath)),
  })
  console.log('auto launch path:', path.join(execDirPath, path.basename(process.execPath)))
  console.log('[AutoLaunch]', enabled ? 'enabled' : 'disabled')
}

/**
 * 创建菜单栏
 */
function createMenu() {
  const template = [
    {
      label: 'File',
      submenu: [
        {
          label: '开机自动启动',
          type: 'checkbox',
          checked: autoLaunchEnabled,
          click: (menuItem) => {
            setAutoLaunch(menuItem.checked)
          },
        },
        { type: 'separator' },
        {
          label: '后台管理',
          click: async () => {
            const { shell } = require('electron')
            await shell.openExternal('https://admin.yuhuashuwu.cn')
          },
        },
        {
          label: '说明文档',
          click: async () => {
            const { shell } = require('electron')
            await shell.openExternal('https://help.yuhuashuwu.cn/doc/instruction.pdf')
          },
        },
        { type: 'separator' },
        { role: 'reload' },
        { role: 'forcereload' },
        { role: 'toggledevtools' },
        { role: 'togglefullscreen' },
        { type: 'separator' },
        { role: 'quit' }, // 保留原来的 Quit
      ],
    },
  ]

  const menu = Menu.buildFromTemplate(template)
  Menu.setApplicationMenu(menu)
}

/**
 * 主函数
 */
app.commandLine.appendSwitch('log-level', '3') // Sets log level to LOG_ERROR to remove unnecessary logs
app.whenReady().then(() => {
  initAutoLaunchState()
  if (!autoLaunchEnabled) {
    setAutoLaunch(true)
  }

  registerFontAssets()

  createWindow()

  createMenu()
})

// 三击切换全屏
ipcMain.handle('toggle-fullscreen', () => {
  win.setFullScreen(!win.isFullScreen())
})
